{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDeveloperWrappedPersona",
  "type": "object",
  "required": [
    "archetype_id",
    "archetype_title",
    "archetype_en",
    "one_liner",
    "secondary_badges",
    "memes",
    "axis_notes"
  ],
  "properties": {
    "display_name": { "type": "string", "maxLength": 40 },
    "archetype_id": {
      "type": "string",
      "enum": [
        "nightshift-orchestrator",
        "swarm-commander",
        "shell-alchemist",
        "fullstack-maverick",
        "verification-purist",
        "full-auto-speedrunner",
        "minimalist-craftsman"
      ]
    },
    "archetype_title": { "type": "string", "minLength": 2, "maxLength": 36 },
    "archetype_en": { "type": "string", "minLength": 2, "maxLength": 48 },
    "one_liner": { "type": "string", "minLength": 4, "maxLength": 160 },
    "one_liner_en": { "type": "string", "minLength": 4, "maxLength": 180 },
    "secondary_badges": {
      "type": "array",
      "items": { "type": "string", "maxLength": 28 },
      "minItems": 1,
      "maxItems": 4
    },
    "secondary_badges_en": {
      "type": "array",
      "items": { "type": "string", "maxLength": 32 },
      "minItems": 1,
      "maxItems": 4
    },
    "memes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["tag", "line"],
        "properties": {
          "tag": { "type": "string", "minLength": 2, "maxLength": 40 },
          "tag_en": { "type": "string", "minLength": 2, "maxLength": 40 },
          "line": { "type": "string", "minLength": 4, "maxLength": 160 },
          "line_en": { "type": "string", "minLength": 4, "maxLength": 180 }
        }
      }
    },
    "axis_notes": {
      "type": "object",
      "required": [
        "orchestration",
        "shell_craft",
        "domain_span",
        "verification",
        "night_ops",
        "autonomy"
      ],
      "properties": {
        "orchestration": { "type": "string", "maxLength": 100 },
        "shell_craft": { "type": "string", "maxLength": 100 },
        "domain_span": { "type": "string", "maxLength": 100 },
        "verification": { "type": "string", "maxLength": 100 },
        "night_ops": { "type": "string", "maxLength": 100 },
        "autonomy": { "type": "string", "maxLength": 100 }
      }
    },
    "axis_notes_en": {
      "type": "object",
      "properties": {
        "orchestration": { "type": "string", "maxLength": 100 },
        "shell_craft": { "type": "string", "maxLength": 100 },
        "domain_span": { "type": "string", "maxLength": 100 },
        "verification": { "type": "string", "maxLength": 100 },
        "night_ops": { "type": "string", "maxLength": 100 },
        "autonomy": { "type": "string", "maxLength": 100 }
      }
    },
    "radar_overrides": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 }
    }
  }
}
