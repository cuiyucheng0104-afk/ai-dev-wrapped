{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDeveloperWrappedPersona",
  "type": "object",
  "required": [
    "archetype_id",
    "archetype_title",
    "archetype_en",
    "one_liner",
    "secondary_badges",
    "memes",
    "axis_notes"
  ],
  "properties": {
    "display_name": { "type": "string", "maxLength": 40 },
    "archetype_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 48,
      "description": "1-of-1 kebab-case slug analyzed and coined freely by the user's agent from facts.json"
    },
    "archetype_title": { "type": "string", "minLength": 2, "maxLength": 36 },
    "archetype_en": { "type": "string", "minLength": 2, "maxLength": 48 },
    "one_liner": { "type": "string", "minLength": 4, "maxLength": 160 },
    "one_liner_en": { "type": "string", "minLength": 4, "maxLength": 180 },
    "secondary_badges": {
      "type": "array",
      "items": { "type": "string", "maxLength": 28 },
      "minItems": 1,
      "maxItems": 4
    },
    "secondary_badges_en": {
      "type": "array",
      "items": { "type": "string", "maxLength": 32 },
      "minItems": 1,
      "maxItems": 4
    },
    "memes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["tag", "line"],
        "properties": {
          "tag": { "type": "string", "minLength": 2, "maxLength": 40 },
          "tag_en": { "type": "string", "minLength": 2, "maxLength": 40 },
          "line": { "type": "string", "minLength": 4, "maxLength": 160 },
          "line_en": { "type": "string", "minLength": 4, "maxLength": 180 }
        }
      }
    },
    "axis_notes": {
      "type": "object",
      "required": [
        "night_owl",
        "boss_energy",
        "gear_hoarder",
        "trust_issues",
        "chaos_grit",
        "ai_addict"
      ],
      "properties": {
        "night_owl": { "type": "string", "maxLength": 100 },
        "boss_energy": { "type": "string", "maxLength": 100 },
        "gear_hoarder": { "type": "string", "maxLength": 100 },
        "trust_issues": { "type": "string", "maxLength": 100 },
        "chaos_grit": { "type": "string", "maxLength": 100 },
        "ai_addict": { "type": "string", "maxLength": 100 }
      }
    },
    "axis_notes_en": {
      "type": "object",
      "properties": {
        "night_owl": { "type": "string", "maxLength": 100 },
        "boss_energy": { "type": "string", "maxLength": 100 },
        "gear_hoarder": { "type": "string", "maxLength": 100 },
        "trust_issues": { "type": "string", "maxLength": 100 },
        "chaos_grit": { "type": "string", "maxLength": 100 },
        "ai_addict": { "type": "string", "maxLength": 100 }
      }
    },
    "verdict_level": { "type": "string", "minLength": 2, "maxLength": 36 },
    "verdict_level_en": { "type": "string", "minLength": 2, "maxLength": 48 },
    "verdict_body": { "type": "string", "minLength": 6, "maxLength": 220 },
    "verdict_body_en": { "type": "string", "minLength": 6, "maxLength": 260 }
  }
}
